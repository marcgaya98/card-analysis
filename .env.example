# Application Settings
APP_NAME="Yu-Gi-Oh! Card Genre Classifier API"
APP_VERSION="2.0.0"
DEBUG=false
LOG_LEVEL=INFO
PORT=8000

# Model & Inference Settings
MODEL_NAME=roberta-base
MODEL_PATH=./models/card-genre-classifier
MAX_LENGTH=512
BATCH_SIZE=32
THRESHOLD=0.5
CUDA_AVAILABLE=true
USE_MIXED_PRECISION=true

# Database Settings (for training/data_from_db.py extraction)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=yugioh
